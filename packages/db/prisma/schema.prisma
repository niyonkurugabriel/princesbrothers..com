generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum ContributorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventorySource {
  INTERNAL
  CONTRIBUTOR
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum CartStatus {
  ACTIVE
  ABANDONED
  CONVERTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
  REFUNDED
}

enum DeliveryStatus {
  PICKED_UP
  IN_TRANSIT
  DELIVERED
}

enum PaymentGateway {
  STRIPE
  PAYPAL
  CASH_ON_DELIVERY
  MANUAL
}

enum Currency {
  RWF
  USD
  EUR
  GBP
  CAD
}

enum AddressType {
  BILLING
  SHIPPING
  BOTH
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique @db.VarChar(320)
  passwordHash    String?
  firstName       String       @db.VarChar(100)
  lastName        String       @db.VarChar(100)
  phone           String?      @db.VarChar(32)
  status          UserStatus   @default(INVITED)
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  roles       UserRole[]
  customer    Customer?
  contributor Contributor?
  driver      Driver?
  sessions    Session[]
  auditLogs   AuditLog[]
  submissionReviews ContributorSubmission[] @relation("SubmissionReviewer")

  @@index([status])
  @@index([lastName, firstName])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(80)
  description String?
  createdAt   DateTime         @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(150)
  description String?

  roles RolePermission[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses Address[]
  carts     Cart[]
  orders    Order[]
}

model Address {
  id           String      @id @default(uuid()) @db.Uuid
  customerId   String      @db.Uuid
  type         AddressType @default(BOTH)
  label        String?     @db.VarChar(80)
  recipient    String      @db.VarChar(200)
  line1        String      @db.VarChar(200)
  line2        String?     @db.VarChar(200)
  city         String      @db.VarChar(100)
  state        String?     @db.VarChar(100)
  postalCode   String      @db.VarChar(32)
  countryCode  String      @db.Char(2)
  phone        String?     @db.VarChar(32)
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shippingOrders Order[]  @relation("ShippingAddress")
  billingOrders  Order[]  @relation("BillingAddress")

  @@index([customerId, type])
}

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String     @db.Uuid
  status     CartStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([customerId, status])
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([productId])
}

model Product {
  id               String   @id @default(uuid()) @db.Uuid
  sku              String   @unique @db.VarChar(80)
  name             String   @db.VarChar(200)
  slug             String   @unique @db.VarChar(220)
  description      String?
  retailPrice      Decimal  @db.Decimal(12, 2)
  currency         Currency @default(USD)
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categories           ProductCategory[]
  inventoryItems       InventoryItem[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  contributorSubmissions ContributorSubmission[]

  @@index([isActive, createdAt])
  @@index([name])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  parentId  String?  @db.Uuid
  createdAt DateTime @default(now())

  parent   Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]          @relation("CategoryTree")
  products ProductCategory[]

  @@index([parentId])
}

model ProductCategory {
  productId  String @db.Uuid
  categoryId String @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model InventoryItem {
  id            String          @id @default(uuid()) @db.Uuid
  productId     String          @db.Uuid
  contributorId String?         @db.Uuid
  source        InventorySource
  quantity      Int             @default(0)
  reserved      Int             @default(0)
  warehouseCode String?         @db.VarChar(80)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  contributor Contributor? @relation(fields: [contributorId], references: [id], onDelete: SetNull)

  // A nullable contributorId supports internal stock while the source enum keeps the origin explicit.
  @@index([productId, source])
  @@index([contributorId])
}

model Contributor {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @unique @db.Uuid
  companyName  String            @db.VarChar(200)
  registrationNumber String      @unique @db.VarChar(100)
  businessEmail String           @db.VarChar(320)
  location     String            @db.VarChar(200)
  businessDetails String?
  status       ContributorStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions  ContributorSubmission[]
  inventory    InventoryItem[]

  @@index([status, createdAt])
}

model ContributorSubmission {
  id                  String           @id @default(uuid()) @db.Uuid
  contributorId       String           @db.Uuid
  productId           String?          @db.Uuid
  productName         String           @db.VarChar(200)
  description         String?
  proposedWholesalePrice Decimal        @db.Decimal(12, 2)
  currency            Currency         @default(USD)
  quantity            Int
  status              SubmissionStatus @default(DRAFT)
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewedById        String?          @db.Uuid
  rejectionReason     String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  contributor Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  reviewedBy  User?       @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  // productId is optional because a submission may propose a product not yet in the catalog.
  @@index([contributorId, status])
  @@index([productId])
  @@index([reviewedById])
}

model Driver {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  licenseNumber String @unique @db.VarChar(100)
  pinHash     String?
  vehicleInfo String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  routes DeliveryRoute[]
}

model DeliveryRoute {
  id          String         @id @default(uuid()) @db.Uuid
  driverId    String         @db.Uuid
  routeDate   DateTime       @db.Date
  status      DeliveryStatus @default(PICKED_UP)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  driver       Driver         @relation(fields: [driverId], references: [id], onDelete: Restrict)
  orders       Order[]
  proofOfDelivery ProofOfDelivery[]

  @@index([driverId, routeDate])
  @@index([status, routeDate])
}

model ProofOfDelivery {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @unique @db.Uuid
  routeId       String   @db.Uuid
  deliveredAt   DateTime @default(now())
  recipientName String?  @db.VarChar(200)
  signatureUrl  String?
  photoUrl      String?
  notes         String?

  order Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  route DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)

  @@index([routeId, deliveredAt])
}

model Order {
  id                String        @id @default(uuid()) @db.Uuid
  orderNumber       String        @unique @db.VarChar(40)
  customerId        String        @db.Uuid
  shippingAddressId String?       @db.Uuid
  billingAddressId  String?       @db.Uuid
  routeId           String?       @db.Uuid
  status            OrderStatus   @default(PENDING_PAYMENT)
  deliveryStatus    DeliveryStatus?
  currency          Currency
  subtotal          Decimal       @db.Decimal(12, 2)
  shippingTotal     Decimal       @db.Decimal(12, 2)
  taxTotal          Decimal       @db.Decimal(12, 2)
  total             Decimal       @db.Decimal(12, 2)
  placedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shippingAddress Address?           @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress  Address?           @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  route           DeliveryRoute?    @relation(fields: [routeId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]
  proofOfDelivery ProofOfDelivery?

  // Address records remain reusable; production code should also copy the address into an order snapshot at checkout.
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([routeId, deliveryStatus])
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @db.Uuid
  productId      String  @db.Uuid
  productName    String  @db.VarChar(200)
  sku            String  @db.VarChar(80)
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @db.Uuid
  gateway               PaymentGateway
  gatewayTransactionId  String?       @unique @db.VarChar(200)
  currency              Currency
  amount                Decimal       @db.Decimal(12, 2)
  paidAt                DateTime?
  createdAt             DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([gateway, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String   @db.VarChar(100)
  ipAddress  String?  @db.VarChar(64)
  timestamp  DateTime @default(now())
  metadata   Json?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // No updatedAt or delete relation is provided: audit rows are append-only by application policy.
  @@index([actorId, timestamp])
  @@index([entityType, entityId, timestamp])
  @@index([timestamp])
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  tokenHash      String   @unique @db.VarChar(128)
  redisKey       String   @unique @db.VarChar(255)
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Redis stores the live session; this row is the durable revocation/audit reference.
  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}