{
  "name": "@princess-brothers/db",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "db:create": "mysql --host=127.0.0.1 --port=3307 --user=root -p --execute=\"CREATE DATABASE IF NOT EXISTS princesbrothers;\"",
    "db:migrate": "node --env-file=../../.env ../../db/migrate.js",
    "db:seed": "node --env-file=../../.env ../../db/seed.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}