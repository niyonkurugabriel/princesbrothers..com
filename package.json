{
  "name": "princess-and-brothers",
  "version": "0.1.0",
  "private": true,
  "description": "Princess & Brothers e-commerce platform",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@princess-brothers/web",
    "build": "npm run build --workspace=@princess-brothers/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspace=@princess-brothers/web && npm run typecheck --workspace=@princess-brothers/db && npm run typecheck --workspace=@princess-brothers/ui",
    "test": "vitest run",
    "db:generate": "npm run db:generate --workspace=@princess-brothers/db",
    "db:push": "npm run db:push --workspace=@princess-brothers/db"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  },
  "engines": { "node": ">=20.0.0" }
}